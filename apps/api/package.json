{
  "name": "@id-call/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "retention:prune": "tsx src/retention/prune.ts"
  },
  "dependencies": {
    "@id-call/contracts": "*",
    "@id-call/phone-domain": "*",
    "@id-call/reputation-domain": "*",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
